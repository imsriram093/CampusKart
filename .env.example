# Copy this file to .env and fill in your lab Oracle account.
#   oracle = Oracle only   mirror = offline SQLite mirror   auto = Oracle, else mirror
CK_DB_MODE=auto
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
# host:port/service_name  (XE 21c: XEPDB1, Oracle 23ai Free: FREEPDB1)
ORACLE_DSN=localhost:1521/XEPDB1
CK_PORT=5000
